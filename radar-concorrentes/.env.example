# Copie este arquivo para .env.local e preencha só o que quiser usar.

# Opcional. Liga a geração de ideias e roteiros direto na plataforma.
# Sem ela, a plataforma monta o prompt e você cola no claude.ai.
# Crie em https://console.anthropic.com
ANTHROPIC_API_KEY=

# Opcional. Use só se o Instagram começar a bloquear a coleta.
# Valor do cookie "sessionid" do instagram.com no seu navegador (logado).
INSTAGRAM_SESSIONID=
