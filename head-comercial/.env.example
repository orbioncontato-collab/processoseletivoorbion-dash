# Copie para .env.local e preencha. Nunca envie .env.local para o GitHub.

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Chave secreta: só no servidor. Ignora as regras de RLS, por isso é usada
# apenas depois de checar permissão no código.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Endereço público do app (usado nos links de convite e recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Testes de banco (scripts/test-db.sh imprime este valor)
DATABASE_URL_TEST=postgres://postgres@127.0.0.1:54329/head_comercial_test
