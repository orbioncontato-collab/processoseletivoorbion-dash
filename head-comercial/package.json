{
  "name": "head-comercial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:test:up": "scripts/test-db.sh up",
    "db:test:reset": "scripts/test-db.sh reset",
    "db:test:down": "scripts/test-db.sh down",
    "db:types": "supabase gen types typescript --db-url \"${DATABASE_URL_TEST:-postgresql://postgres@127.0.0.1:54329/head_comercial_test}\" --schema public > .types.tmp 2>/dev/null && mv .types.tmp src/lib/supabase/database.types.ts && npx --yes oxfmt src/lib/supabase/database.types.ts || (rm -f .types.tmp; echo \"Banco local desligado: rode npm run db:test:up\" >&2; exit 1)",
    "test:e2e": "playwright test --trace off",
    "admin:create": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.9.2",
    "lucide-react": "^1.78.0",
    "mammoth": "^1.13.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "unpdf": "^2.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "^8.23.1",
    "supabase": "^3.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
